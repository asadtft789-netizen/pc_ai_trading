[Unit]
Description=Self-Evolving Trading AI Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/pc_ai_trading
ExecStartPre=/usr/bin/python3 -m pip install -q -r requirements.txt
ExecStart=/usr/bin/python3 -u /root/pc_ai_trading/main.py
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/root/pc_ai_trading/.env

# Run as root (user's setup)
User=root
Group=root

# Logs go to journald; view with: journalctl -u self_evolving_trader -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
