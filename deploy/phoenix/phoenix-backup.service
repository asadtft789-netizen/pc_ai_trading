[Unit]
Description=Phoenix Hourly verified WAL backup
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=oneshot
User=phoenix-backup
Group=phoenix-state
WorkingDirectory=/opt/phoenix/current
Environment=PAPER_DB=/var/lib/phoenix/state/operational.sqlite
Environment=PYTHON_DOTENV_DISABLED=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
EnvironmentFile=/opt/phoenix/current/revision.env
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
LogNamespace=phoenix
ExecStart=/opt/phoenix/current/venv/bin/python -m backup_sets backup /var/lib/phoenix/state/operational.sqlite /var/backups/phoenix /var/lib/phoenix/telemetry/backup/status.json
EnvironmentFile=-/etc/phoenix/backup.env
ReadOnlyPaths=/var/lib/phoenix/state
ReadWritePaths=/var/backups/phoenix /var/lib/phoenix/telemetry/backup
TimeoutStartSec=10min
MemoryMax=128M
CPUWeight=30
CPUQuota=40%
TasksMax=30
