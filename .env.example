# Alpaca Paper Trading API keys
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional LLM provider for autonomous strategy invention (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Trading universe & capital
TRADE_UNIVERSE=AAPL,MSFT,NVDA,TSLA,BTC/USD,ETH/USD
MAX_CAPITAL_USD=10
MAX_POSITION_USD=1
MAX_DAILY_LOSS_USD=0.50

# Runtime — relative paths work on any OS / container (Linux, Pterodactyl, Windows)
DATA_DIR=data
DB_PATH=data/memory.sqlite
LOG_LEVEL=INFO
